# ---------------------------------------------------------------------------
# RevenueCat
# ---------------------------------------------------------------------------
# Public SDK keys. Safe to ship in the client bundle -- they are publishable
# keys, not secrets. Leave empty during development: the app falls back to a
# local entitlement mode and says so on the subscription screen.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ---------------------------------------------------------------------------
# AdMob (Android)
# ---------------------------------------------------------------------------
# Leave BOTH empty to use Google's published test ids. Never ship a release
# build with test ids, and never point a development build at production ids --
# clicking your own live ads is a policy violation that can close your account.
#
# App id is baked into AndroidManifest.xml at prebuild time, so changing it
# requires `npx expo prebuild -p android --clean` and a rebuild.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# Banner unit id is read at runtime; changing it only needs a JS reload.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Grants Pro locally so gated flows can be exercised without a purchase.
# MUST be false (or removed) for any release build.
EXPO_PUBLIC_DEV_PRO_MODE=false

# ---------------------------------------------------------------------------
# Firebase Authentication (Android)
# ---------------------------------------------------------------------------
# PUBLIC client configuration only. These identify the project to Firebase and
# are designed to ship in the app bundle -- they are not secrets, and access is
# controlled by Firebase security rules and authorised domains, not by hiding
# them.
#
# NEVER put a Firebase Admin SDK service-account JSON in this repo or the APK.
# That IS a secret and belongs only on a server.
#
# Leave empty to disable sign-in entirely: the app still runs, guest-only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# OAuth 2.0 WEB client id from the Firebase console (not the Android one).
# Required for Google Sign-In. Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Where the passwordless email link returns to. Must be on an authorised domain
# in Firebase Console -> Authentication -> Settings. Leave empty to hide the
# email option. See AUTH.md -- Firebase has no email OTP, only sign-in links.
EXPO_PUBLIC_FIREBASE_EMAIL_CONTINUE_URL=

# ---------------------------------------------------------------------------
# Legal links (REQUIRED before a Play Store release)
# ---------------------------------------------------------------------------
# Google Play requires a privacy policy URL for any app handling personal or
# sensitive data -- reading usage statistics counts. Publish the text in
# PRIVACY_POLICY.md somewhere public (GitHub Pages is fine) and put the URL
# here AND in the Play Console listing. The in-app link is hidden while this is
# empty, so an unconfigured build shows no dead link.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Play's account-deletion policy wants a web route as well as the in-app one,
# for people who have already uninstalled the app.
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
